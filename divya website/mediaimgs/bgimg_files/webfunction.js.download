$('select[name="SortPackage"]').on('change', function () {
    var countryId = $(this).data('countryid');
    var type = $(this).data('vacationtype');
    var cities = $(this).data('cities');
    if (countryId === '') {
        countryId = 0;
    }
    if (type === '') {
        type = '-1';
    }
    if (cities === '') {
        cities = '0';
    }
    var culture = $('input[name="hidculture"]').val();
    $.ajax({
        url: '/Home/SortedVacationPackage',
        type: 'GET',
        data: {
            countryId: countryId,
            vacationType: type,
            cities: cities,
            sortType: $(this).val(),
            culture: culture
        },
        success: function (result) {
            $('#loading').hide();
            $('div[name="PackageList"]').html(result);
        },
        beforeSend: function () {
            $('#loading').show();
            $('div[name="PackageList"]').html('');
        }
    });
});

$('select[name="SortSearchPackage"]').on('change', function (e) {
    var type = $('[name="Type"]').val();
    var country = $('[name="Country"]').val();
    var departure = $('[name="Departure"]').val();
    var key = $('[name="Key"]').val();
    //ritz 不区分语言版本也没有小系列
    //var culture = $('input[name="hidculture"]').val();
    //var smallSeriesCode = $('select[name="SortSearchPackage"]').data("smallseriescode");
    var $lis = $('ul[role="tablist"]').find('li[name!="SortList"]');
    //var year = $('a[aria-selected="true"]').attr("aria-controls");
    var year = 0;
    $.each($lis, function (i) {
        if ($lis.eq(i).hasClass('is-active')) {
            year = $(this).attr("year");
        }
    });
    $.ajax({
        url: '/Home/SortedSearchVacationPackage',
        type: 'GET',
        data: {
            region: $('[name="Region"]').val(),
            country: country,
            destination: country,
            searchType: type,
            departure: departure,
            key: key,
            sortType: $(this).val(),
            year: year
        },
        success: function (result) {
            $('#loading').hide();
            $("#" + year + "TRIPS").html(result);
        },
        beforeSend: function () {
            $('#loading').show();
            $("#" + year + "TRIPS").html("");
        }
    });
});

$(document).on('click', '[data-modal-target="reviewsGalleryModal"]', function (e) {
    e.preventDefault();
    var $btn = $(this);
    var reviewId = $btn.data('review-id');
    var reviewIndex = parseInt($btn.data('review-index')) || 0;
    $.get('/Home/GetReviewPopUp', { reviewId: reviewId }, function (html) {
        var $modal = $('#reviewsGalleryModal');
        $modal.html(html);

        // Initialize Swiper for the reviews gallery
        if ($('.reviews-gallery-swiper').length) {
            var slideCount = $('.reviews-gallery-swiper .swiper-slide').length;
            var isSingleSlide = slideCount <= 1;
            new Swiper('.reviews-gallery-swiper', {
                loop: false,
                initialSlide: reviewIndex,
                spaceBetween: 20,
                allowTouchMove: !isSingleSlide,
                pagination: isSingleSlide ? false : {
                    el: '.reviews-gallery-pagination',
                    clickable: true,
                },
                navigation: isSingleSlide ? false : {
                    nextEl: '.reviews-gallery-next',
                    prevEl: '.reviews-gallery-prev',
                },
                keyboard: {
                    enabled: !isSingleSlide,
                },
                a11y: {
                    enabled: true,
                },
            });
            if (isSingleSlide) {
                $('.reviews-gallery-next, .reviews-gallery-prev, .reviews-gallery-pagination').hide();
            }
        }
    });
});

