    var $thankYou = $cta.find('.thank-you');
    var $question = $cta.find('.question');

    $buttons.hide();
    $question.hide();
    $thankYou.addClass('is-visible');
    $btn.addClass('is-voted');

    console.log('Vote recorded:', $btn.data('vote'));
});
