$('[data-expand]').on('click', function(ev) {
  var $this = $(this);
  var $panel = $($this.data('expand'));
  if (!$panel.length) {
    return;
  }
  ev.preventDefault();
  $panel.toggleClass('state--show');
});

$("#menu-toggle").click(function () {
    $("#rightDiv").css("position", "relative");
})
$("#close-menu").click(function () {
    $("#rightDiv").css("position", "fixed");
})

$('[data-expand-change]').each(function() {
  // console.log();
  var $toggle = $(this);
  var $panel = $($toggle.data('expand-change'));
  $('input[type="radio"][name="' + $toggle.attr('name') + '"]').on(
    'change',
    function(ev) {
      $panel.toggleClass(
        'state--show',
        this.hasAttribute('data-expand-change')
      );
    }
  );
});

// });on('change', function(ev) {
//   console.log(this);
// });

$('.back-to-top').on('click', function(ev) {
  var href = $(this).attr('href');
  var $target = $(href);
  if (!$target.length || !$target[0].scrollIntoView) {
    return;
  }
  ev.preventDefault();
  $target[0].scrollIntoView({
    block: 'start',
    behavior: 'smooth'
  });
});
