function hideDestinationCountries(contrytitle) {
    $(contrytitle).next('div').slideToggle();
    $(contrytitle).removeClass("contrytitleactive");
    $(contrytitle).next().next().css("display", "none");
    $(".filterbox").removeAttr("style");
    $(contrytitle).css({ "padding-right": "16px", "color": "#616161" });
    var $title = $(".sx_contrytitle");
    //$(".sx_countrylist").css("display", "none");
    if ($title.length > 0) {
        $.each($title, function (i, e) {
            var $this = $(this);
            $(this).parent().removeAttr("style", "border:none");
        });
    }
    ////清空这个destination下面选中的country
    //$(contrytitle).next('div').find("input[name='chkregioncountry']:checked").prop('checked', false);
}
function Is_PC_UserPackages(page, selSeriesId, selSeriesType, isPhone) {
    $("#packageCount").val(1);

    var sortType = $("[name='SortFilterPackage']").attr('id');
    var $year = $("input[type='radio'][name='rdoYear']:checked");
    var year = $year.val();
    var $series = $("input[type='checkbox'][name='chkSeriesCountry']");
    var filterJson = buildFilterObject(year);
    var queryObj = "";
    var $private = $("input[type='checkbox'][name='chkPrivate']").prop("checked");
    var $group = $("input[type='checkbox'][name='chkGroup']").prop("checked");
    var series = [];
    var seriesType = "";
    // op2为Trip Type，故作List<string>处理
    var op2 = [];
    if ($private) {
        op2.push("Private");
    }
    if ($group) {
        op2.push("Group");
    }
    //if ($private == false && selSeriesType == "Private") { selSeriesType = '@seriesType'; }//取消private classic tour
    var ishotdeal = $("input[id='ishotdeal']").val();
    if (year == null || year == "") {
        year = 0;
    }

    //if (selSeriesType == "Private" && $private) {
    //    if (selSeriesId == 0 || selSeriesId == null) {
    //        seriesType = '@seriesType';
    //    }
    //}
    $.each($(".sx_contrytitle"), function (i, data) {
        $(data).parent().hide();
    });
    //点系列下面的国家走的逻辑
    $.each($series, function (i, e) {
        var $this = $(this);
        seriesType = $this.data('seriestype');
        var seriesId = $this.data('seriesid');
        var countryId = $this.data('countryid');
        var countryName = $this.data('countryname');
        //var isSeriesActivated = $this.parents(".contrytitleactivechecked").length > 0;
        var years = $this.data('year');
        if (years.indexOf(year) > 0) {
            $this.parents("#seriesLeftWidgetDiv").find(".sx_contrytitle").parent().show();
            $this.parents('label').removeClass("sx_disableclick");
            var checked = $this.prop("checked");
            if (checked)
                if (series.find(e => e.SeriesType == seriesType && e.SeriesId == seriesId) != null) {
                    var obj = series.find(e => e.SeriesType == seriesType && e.SeriesId == seriesId);

                    var country = {};
                    country.CountryId = countryId;
                    country.countryName = countryName;
                    obj.SeriesCountry.push(country);
                } else {
                    var obj = new Object();
                    obj.SeriesType = seriesType;
                    obj.SeriesId = seriesId;
                    obj.SeriesCountry = [];

                    var country = {};
                    country.CountryId = countryId;
                    country.countryName = countryName;
                    obj.SeriesCountry.push(country);

                    series.push(obj);
                }
        } else {
            $this.parents('label').addClass("sx_disableclick");
            //$this.prop("checked", false);
        }
    })
    $.each($(".sx_contrytitle"), function (i, data) {
        if ($(data).parent().is(":hidden") && $(data).hasClass("contrytitleactive")) {
            $(data).click();
        }
    });
    $.each($series, function (i, e) {
        var $this = $(this);
        seriesType = $this.data('seriestype');
        var seriesId = $this.data('seriesid');
        var countryId = $this.data('countryid');
        var countryName = $this.data('countryname');
        //var isSeriesActivated = $this.parents(".contrytitleactivechecked").length > 0;
        var years = $this.data('year');
        if (years.indexOf(year) > 0) {
            var checked = $this.prop("checked");
            if (checked) {
                if ((!$this.parents("#seriesLeftWidgetDiv").find(".sx_contrytitle").parent().is(":hidden")) && (!$this.parents("#seriesLeftWidgetDiv").find(".sx_contrytitle").hasClass("contrytitleactive"))) {
                    $this.parents("#seriesLeftWidgetDiv").find(".sx_contrytitle").click();
                }
            }
        }
    });
    if (selSeriesId > 0 && series.length == 0) {
        var obj = new Object();
        //obj.SeriesType = selSeriesType;
        obj.SeriesId = selSeriesId;
        obj.SeriesCountry = [];
        series.push(obj);
    }

    $('.newlayout__innersxtitle').next().show();
    var height = 0;
    if (isPhone == 1) {
        height = $(".phonemorebtn").offset().top;
    }
    if (ajaxIs_PC_UserPackages != undefined) {
        ajaxIs_PC_UserPackages.abort();//停止上一次ajax请求
    }
    if (page != 1) {
        ajaxIs_PC_UserPackages = $.ajax({
            url: "/Home/FilterPackages",
            type: "post",
            data: { 'filterJson': JSON.stringify(filterJson), 'sortType': sortType, 'year': year, 'series': series, 'seriesType': seriesType, 'option': op2, 'isPhone': isPhone, 'page': page, 'isHotDeal': ishotdeal, 'showmore': true },
            success: function (data) {
                if (page != 1) {
                    $(".packagelistpage").remove();
                    $("#ModelCount").remove();
                    $('#filterdiv').append(data);
                    if (!ishotdeal) {
                        getSeries(selSeriesId);
                    }
                }
               

            },
            beforeSend: function () {
                //$("#divcover").show();
                $('#Showmoreloader').html('<img style="width:30px;height:30px;margin:auto;margin-top: 10%;" src="/asset/img/ajax-loader.gif"/>');

            },
            complete: function () {
                //$("#divcover").hide();
                $('#Showmoreloader').find("img").remove();

            }
        })
    } else {

        $(".packagelistpage").text("Showing 1 - 6 of  " + $("#totalCount").val() + "  Trips")
        /*  < input type="hidden" id="ModelCount" value="6" /> */
        $("#ModelCount").val(6);
        $('#filterdiv>.layout__item:eq(5)').nextAll(".layout__item").remove();
        if (!ishotdeal) {
            getSeries(selSeriesId);
        }
    }
   
}