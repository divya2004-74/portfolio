//获取url上传递的参数值
function getUrlParamString(name) {
    let reg = new RegExp("(^|)" + name + "=([^_]*)", "i");
    let r = location.search.substr(1).match(reg);
    if (r != null) {
        return decodeURIComponent(r[2]);
    };
    return null;
}


function NextPaget(page, isPhone) {
    var query = getQueryString('query');
    var urlhead = location.href.split('?')[0];
    var seriesCode = urlhead.substring(urlhead.lastIndexOf('/') + 1);
    var seriesType = urlhead.substring(urlhead.lastIndexOf('/') - 1, urlhead.lastIndexOf('/'));
    seriesCode = decodeURIComponent(seriesCode);
    var aa = $("input[type='checkbox'][name='chkSeriesCountry']").prop("checked");

    var $seriesLeftWidgetDiv = $('div[name="seriesLeftWidgetDiv"]');
    var seriesId = $seriesLeftWidgetDiv.find("p[class='sx_contrytitle contrytitleactive'][seriescode='" + seriesCode + "']" + "[seriestype='" + seriesType + "']").attr("seriesid");
    if (query != null && query != undefined && query != "") {
        if (!(seriesId != null && seriesId != undefined && seriesId != "")) {
            //如果系列没有就差seriestype所有的
            if (seriesType == "C")//cp那边勾选全部取消然后点下一页
                seriesId = 0;
            if (seriesType == "P")
                seriesId = 0;
        }
    }
    filterPackages(page, seriesId, seriesType, isPhone);
}


