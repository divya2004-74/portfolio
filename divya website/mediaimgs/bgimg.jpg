<style>
    #cc-widget * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    #cc-banner {
        position: fixed;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        width: 580px;
        max-width: calc(100vw - 32px);
        background: #FFF;
        border-radius: 4px;
        box-shadow: 0 8px 40px rgba(0,0,0,.18);
        font-family: "Karla";
        overflow: hidden;
        transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }

        #cc-banner.cc-hidden {
            opacity: 0;
            transform: translateX(-50%) translateY(50px);
            pointer-events: none;
        }

    #cc-header {
        background: #00424e;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        #cc-header svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }

        #cc-header span {
            font-family: 'Karla bold';
            color: #FFF;
            font-size: 16px;
        }

    #cc-body {
        padding: 14px 20px 4px;
    }

        #cc-body p {
            font-family: 'Karla';
            font-size: 14px;
            color: #00424e;
            line-height: 1.6;
        }

        #cc-body a {
            color: #00424e;
            text-decoration:none;
        }

    #cc-settings-panel {
        padding: 0 20px;
        display: none;
        flex-direction: column;
    }

        #cc-settings-panel.cc-open {
            display: flex;
        }

    .cc-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 7px 0 !important;
        background-color: #f1f1f1;
        border-radius: 6px;
        padding: 0 10px !important;
    }

    .cc-row-info {
        flex: 1;
        padding: 10px 5px 10px 0 !important;
    }

        .cc-row-info strong {
            display: block;
            font-size: 14px;
            color: #00424e;
        }

        .cc-row-info small {
            font-size: 14px;
            color: #00424e;
            line-height: 1.4;
        }

    .cc-toggle {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 22px;
        flex-shrink: 0;
        margin-top: 2px;
    }

        .cc-toggle input {
            display: none;
        }

    .cc-slider {
        position: absolute;
        inset: 0;
        background: #ddd;
        border-radius: 22px;
        cursor: pointer;
        transition: background .2s;
    }

        .cc-slider:before {
            content: '';
            position: absolute;
            width: 16px;
            height: 16px;
            left: 3px;
            top: 3px;
            background: #fff;
            border-radius: 50%;
            transition: transform .2s;
            box-shadow: 0 1px 4px rgba(0,0,0,.2);
        }

    .cc-toggle input:checked + .cc-slider {
        background: #1a1a2e;
    }

        .cc-toggle input:checked + .cc-slider:before {
            transform: translateX(18px);
        }

    .cc-toggle input:disabled + .cc-slider {
        opacity: .45;
        cursor: not-allowed;
    }

    #cc-actions {
        padding: 14px 20px 18px;
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .cc-btn {
        padding: 9px 20px !important;
        border-radius: 8px;
        border: none;
        font-family: 'Bebas Neue Bold';
        font-size: 14px;
        cursor: pointer;
        transition: opacity .15s;
        white-space: nowrap;
        color:white;
    }

        .cc-btn:hover {
            opacity: .85;
        }

    #cc-btn-reject {
        background: #f0f0f3;
        color: #00424e;
    }

    #cc-btn-settings {
        background: #f0f0f3;
        color: #00424e;
    }

    #cc-btn-accept {
        background: #00424e;
        color: #FFF;
    }

    @media screen and (max-width: 768px) {
    .cc-btn {
        padding: 7px !important;
    }
}
</style>

<div id="cc-widget">
    <div id="cc-banner" class="cc-hidden" role="dialog" aria-label="Cookie consent">

        <div id="cc-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="#C2977B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"></path>
                <circle cx="11.5" cy="9.5" r=".5" fill="#C2977B;"></circle>
                <circle cx="7.5" cy="14.5" r=".5" fill="#C2977B;"></circle>
                <circle cx="14.5" cy="14.5" r=".5" fill="#C2977B;"></circle>
            </svg>
            <span>Your privacy choices</span>
        </div>

        <div id="cc-body">
            <p>
                We use cookies to provide you with the best possible experience.
                You can manage your categories below or change your mind at any time via the link in our footer.
                For more information, please review our <a href="https://www.ritztours.com/privacy-policy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.
            </p>
        </div>

        <div id="cc-settings-panel">
            <div class="cc-row">
                <div class="cc-row-info">
                    <strong>Necessary</strong>
                    <small>
                        These cookies are necessary for the services and viewing experience of this site, 
                        and cannot be opted out of via this tool.
                    </small>
                </div>
                <label class="cc-toggle">
                    <input type="checkbox" id="cc-necessary" checked="" disabled="">
                    <span class="cc-slider"></span>
                </label>
            </div>
            <div class="cc-row">
                <div class="cc-row-info">
                    <strong>Analytics</strong>
                    <small>Helps us understand how visitors use the site.</small>
                </div>
                <label class="cc-toggle">
                    <input type="checkbox" id="cc-analytics" checked="">
                    <span class="cc-slider"></span>
                </label>
            </div>
            <div class="cc-row">
                <div class="cc-row-info">
                    <strong>Marketing</strong>
                    <small>May be used to show relevant ads on other platforms.</small>
                </div>
                <label class="cc-toggle">
                    <input type="checkbox" id="cc-marketing" checked="">
                    <span class="cc-slider"></span>
                </label>
            </div>
        </div>

        <div id="cc-actions">
            <button class="cc-btn" id="cc-btn-reject">Essential Only</button>
            <button class="cc-btn" id="cc-btn-settings">Settings</button>
            <button class="cc-btn" id="cc-btn-accept">Accept All</button>
        </div>

    </div>
</div>

<script type="text/javascript">
    (function () {
        var COOKIE_NAME = 'site_consent';
        var DISMISS_COOKIE = 'site_consent_dismissed'; // 自動隱藏後，本次瀏覽不再跳出（session cookie，關閉瀏覽器即失效）
        var EXPIRE_DAYS = 180;
        var AUTO_HIDE_MS = 5000; // 顯示 5 秒後自動隱藏
        var settingsOpen = false;
        var autoHideTimer = null;

        function setCookie(name, val, days) {
            var expires = '';
            if (days) { // 不帶 days = session cookie
                var d = new Date();
                d.setTime(d.getTime() + days * 864e5);
                expires = '; expires=' + d.toUTCString();
            }
            document.cookie = name + '=' + encodeURIComponent(val) +
                expires + '; path=/; SameSite=Lax';
        }
        function getCookie(name) {
            var m = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]*)'));
            return m ? decodeURIComponent(m[1]) : null;
        }

        // 推送到 GTM (Google Consent Mode v2) 的功能
        function applyConsentToGTM(prefs) {
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }

            // 更新 Google Consent Mode
            gtag('consent', 'update', {
                'analytics_storage': prefs.analytics ? 'granted' : 'denied',
                'ad_storage': prefs.marketing ? 'granted' : 'denied',
                'ad_user_data': prefs.marketing ? 'granted' : 'denied',
                'ad_personalization': prefs.marketing ? 'granted' : 'denied'
            });

            // 推送一個自訂事件，方便你在 GTM 設定觸發條件
            window.dataLayer.push({
                'event': 'cookie_consent_update',
                //'analytics_permitted': prefs.analytics,
                //'marketing_permitted': prefs.marketing
            });
        }
        // --------------------------------------------------------

        var banner = document.getElementById('cc-banner');
        var panel = document.getElementById('cc-settings-panel');
        var btnSettings = document.getElementById('cc-btn-settings');
        var chkAnalytics = document.getElementById('cc-analytics');
        var chkMarketing = document.getElementById('cc-marketing');

        function showBanner() { banner.classList.remove('cc-hidden'); }
        function hideBanner() {
            stopAutoHide();
            banner.classList.add('cc-hidden');
        }

        // ---------- 自動隱藏 ----------
        function stopAutoHide() {
            if (autoHideTimer) {
                clearTimeout(autoHideTimer);
                autoHideTimer = null;
            }
        }
        function startAutoHide() {
            stopAutoHide();
            if (settingsOpen) return; // 使用者正在看設定，不要收起來
            autoHideTimer = setTimeout(function () {
                // 不寫入 site_consent（使用者沒有做選擇，維持 layout 的預設 consent）
                // 只記一個 session cookie，避免每換一頁又跳出來擋畫面
                setCookie(DISMISS_COOKIE, '1');
                hideBanner();
            }, AUTO_HIDE_MS);
        }

        // 滑鼠移到 banner 上 / 鍵盤聚焦時暫停，離開後重新計時
        banner.addEventListener('mouseenter', stopAutoHide);
        banner.addEventListener('mouseleave', function () {
            if (!banner.classList.contains('cc-hidden')) startAutoHide();
        });
        banner.addEventListener('focusin', stopAutoHide);
        banner.addEventListener('focusout', function (e) {
            if (!banner.contains(e.relatedTarget) && !banner.classList.contains('cc-hidden')) startAutoHide();
        });
        // --------------------------------

        function save(prefs) {
            setCookie(COOKIE_NAME, JSON.stringify(prefs), EXPIRE_DAYS);
            applyConsentToGTM(prefs); // 儲存時同步推送到 GTM
            hideBanner();
        }

        window.openCookieSettings = function () {
            if (!banner) return;
            stopAutoHide(); // 使用者主動從頁尾打開，不自動隱藏
            showBanner();
            if (!settingsOpen) {
                btnSettings.click();
            }
        };

        document.getElementById('cc-btn-accept').addEventListener('click', function () {
            chkAnalytics.checked = true;
            chkMarketing.checked = true;
            save({ necessary: true, analytics: true, marketing: true });
        });

        document.getElementById('cc-btn-reject').addEventListener('click', function () {
            chkAnalytics.checked = false;
            chkMarketing.checked = false;
            save({ necessary: true, analytics: false, marketing: false });
        });

        btnSettings.addEventListener('click', function () {
            settingsOpen = !settingsOpen;
            if (settingsOpen) {
                stopAutoHide(); // 展開設定後就不自動隱藏
                panel.classList.add('cc-open');
                btnSettings.textContent = 'Save Preferences';
                btnSettings.style.background = '#e8e8f5';
                btnSettings.style.color = '#0c3051';
            } else {
                save({
                    necessary: true,
                    analytics: chkAnalytics.checked,
                    marketing: chkMarketing.checked
                });
                panel.classList.remove('cc-open');
                btnSettings.textContent = 'Settings';
                btnSettings.style.background = '';
                btnSettings.style.color = '';
            }
        });

        // 檢查是否已有 cookie
        var existingCookie = getCookie(COOKIE_NAME);
        if (existingCookie) {
            hideBanner();
            try {
                // 若有 cookie，網頁載入時直接套用設定到 GTM
                var prefs = JSON.parse(existingCookie);

                // 同步 UI 開關狀態，以防使用者點擊設定面板
                if (chkAnalytics) chkAnalytics.checked = prefs.analytics;
                if (chkMarketing) chkMarketing.checked = prefs.marketing;
            } catch (e) { }
        } else if (!getCookie(DISMISS_COOKIE)) {

            setTimeout(function () {
                showBanner();
                startAutoHide();
            }, 1000);
        }
    })();
</script>



