<script>
    $(function () {
        //var tt = $(".scioncard_day").html();
        //$(".scioncard_day").text(tt.replace("/", ""));
        //$(".scioncard_day").text(tt.replace("&nbsp;", " "));
    });

    $(document).ready(function () {

        $(".scioncardimgcion .scionhovericon").hide();

        $(".scioncardimgcion").hover(function () {
            $(this).find(".scionhovericon").stop().fadeTo(400, 1)

        }, function () {
            $(this).find(".scionhovericon").stop().fadeTo(400, 0)

        });
        if ($("#totalCount").val() != undefined) {
            $("#divpackageshowmore").addClass("packagelistshowmore");
            if ($("#totalCount").val() == $("#ModelCount").val() && $("#totalCount").val() > 6) {
                $("#spshowmore").text("Show less");
            }
            else if ($("#totalCount").val() > 6) {
                $("#spshowmore").text("Show more");
            }
            else if ($("#totalCount").val() <= 6) {
                $("#divpackageshowmore").removeClass("packagelistshowmore");
                $("#divpackageshowmore").hide();
            }
        }

    });

    function extractSegment(url) {
        const regex = /(?:\/P\/)([^/?]+)/; // éžæ•èŽ·ç»„æ›´å®‰å…¨
        const match = url.match(regex);
        return match ? match[1] : "";
    }
    
    // åˆ¤æ–­ç”¨æˆ·ä¸Šæ¬¡æœç´¢æ˜¯å¦æœ‰æ•ˆ
    $(function () {
        var currentUrl = window.location.href;
        // å…¶ä»–é¡µé¢å·²åœ¨åŽå°å¤„ç† è¿™é‡Œåªå¤„ç†Filter/Offeré¡µé¢
        var searchFilter = "/Vacation-Packages";
        var searchOffer = "/Home/Offers";
        // è¿™ä¸¤ä¸ªé¡µé¢éœ€è¦ç”¨jsåŠ è½½ å…¶ä»–é¡µé¢ç›´æŽ¥è¿”å›žå³å¯
        if (!currentUrl.toLowerCase().includes(searchFilter.toLowerCase())
            && !currentUrl.toLowerCase().includes(searchOffer.toLowerCase())) {
            return;
        }
        // æ˜¯å¦éœ€è¦æ˜¾ç¤ºæœç´¢æ— æ•ˆæç¤ºä¿¡æ¯
        var userSearchAvailable = $('[name="userSearchAvailable"]:first').val();
        // é˜²æ­¢é‡å¤,åˆ é™¤ä¹‹å‰ä¿¡æ¯ï¼Œå¦‚æžœæœ‰çš„è¯
        $('[name="userSearchTopic"]').remove();
        if (userSearchAvailable == undefined || userSearchAvailable == "true") {
            return;
        }
        if (currentUrl.toLowerCase().includes("All".toLowerCase()) &&
            !currentUrl.toLowerCase().includes("destination".toLowerCase()) && 
            !currentUrl.toLowerCase().includes("option".toLowerCase())
        ) return;;
        // æ ¹æ®ç”¨æˆ·æœç´¢å±•ç¤ºæç¤ºä¿¡æ¯
        var userSearchTopicValue = "";
        var userTopicKey = "";
        var destination = getUrlParamString("destination");
        if (destination != null && destination != undefined && destination != "") {
            userTopicKey = destination;
        }
        const match = currentUrl.match(/series=([^?]*)/);
        if (userTopicKey != null && userTopicKey == "" && match && match[1]) {
            var seriesValue = match[1];
            userTopicKey = seriesValue;
        }
        var option = getUrlParamString("option");
        if (option != null && option != undefined && option != "") {
            if (userTopicKey != "") {
                userTopicKey += "-" + option;
            }
            else {
                userTopicKey += option;
            }

        }
//        var series = extractSegment(currentUrl);
//        if (userTopicKey != null && userTopicKey == "" && series != null && series != undefined && series != "") {
//            userTopicKey = series;
//        }
//        var years = getUrlParamString("year");
//        if (userTopicKey != null && userTopicKey == "" && years != null && years != undefined && years != "") {
//            userTopicKey = years;
//        }
        if (userTopicKey == undefined || userTopicKey == "") return;
        var reg = new RegExp("-", "g"); // "g"ä»£è¡¨å…¨éƒ¨æ›¿æ¢
        userTopicKey = userTopicKey.replace(reg, ", ");
        var reg = new RegExp("%20", "g"); // "g"ä»£è¡¨å…¨éƒ¨æ›¿æ¢
        userTopicKey = userTopicKey.replace(reg, " ");
        userSearchTopicValue = "We couldn't find any matches for \"" + userTopicKey + "\"";
        // åˆ›å»ºæ–°çš„ div å…ƒç´ 
        var newDiv = $("<div name='userSearchTopic'class='nosearchcode' style=\"width: 100%;\"><p>" + userSearchTopicValue +"</p><p>Our popular tours:</p></div>");

        // åœ¨ name ä¸º packageList çš„å…ƒç´ å‰æ’å…¥æ–° div
        $('#filterdiv').prepend($("<div><div>"));
        $('#filterdiv').prepend(newDiv);
    });

    $(document).ready(function () {
        //é˜²æ­¢ç”¨æˆ·å¤šæ¬¡ç‚¹å‡»
        function throttle(func, delay) {
            let lastCall = 0;
            return function (...args) {
                const now = new Date().getTime();
                if (now - lastCall >= delay) {
                    lastCall = now;
                    func(...args);
                }
            };
        }
        // Function to handle the redirect
        function redirectTo(url) {
            window.location.href = url;
        }

        const throttledRedirect = throttle(redirectTo, 4000);

        var lastClickedLink = null; // ç”¨äºŽå­˜å‚¨ä¸Šä¸€æ¬¡ç‚¹å‡»çš„é“¾æŽ¥

        $('.clickpackagelist .card__link').click(function (event) {
            var link = $(this).attr('href'); // èŽ·å–é“¾æŽ¥åœ°å€
            if (link === lastClickedLink) {
                //console.log('ä½ ç‚¹å‡»äº†ç›¸åŒçš„é“¾æŽ¥ï¼');
                if ($(this).attr('href')) {
                    if (!$(this).attr("target")) {
                        //console.log("click");
                        event.preventDefault();
                        const url = $(this).attr('href');
                        throttledRedirect(url);
                    }
                }
            } else {
                lastClickedLink = link; // æ›´æ–°ä¸Šä¸€æ¬¡ç‚¹å‡»çš„é“¾æŽ¥
                //console.log('æ–°é“¾æŽ¥ï¼');
            }
        });
    })
</script>

