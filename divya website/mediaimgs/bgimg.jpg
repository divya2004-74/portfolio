    $(".sx_yeartitle").click(function () {
        $(this).toggleClass('sx_yeartitleactive');
        $(this).next().slideToggle();
    })
    $(".sx_regiontitle").click(function () {
        $(this).toggleClass('regiontitleactive');
        $(this).next().slideToggle();
    })
