$(document).ready(function () {
    $(".onpageselect_txt").click(function (event) {
        event.stopPropagation();


        if ($(this).next(".option").is(":hidden")) {
            $(".onpageselect_txt").next('.option').hide();
            $(this).next(".option").show();
        }
        else {
            $(".onpageselect_txt").next('.option').hide();
            $(this).next(".option").hide();
        }
    });
    $(document).click(function (event) {
        var eo = $(event.target);
        if (eo.closest(".onpageselect_box").length === 0) {
            $(".option").hide();
        }
    });
    /*赋值给文本框*/
    $(".option a").click(function () {
        var value = $(this).text();
        $(this).parent().siblings(".onpageselect_txt").text(value);
        $("#select_value").val(value)
    })
})

$(".deslist_box").click(function () {
    var bool = $(this).find(".deslistmap").is(".mapactive");
    $(".deslist_box").find(".deslistmap").removeClass("mapactive");
    $(this).css({ "pointer-events": "none" })
    $(".deslist_box").css({ "pointer-events": "none" });
    if (!bool) {
        $(this).find(".deslistmap").addClass("mapactive");
        var region = $(this).find(".deslistmap").data("id");
        $(this).parents("form").find(".option_countrybox").show();
        $.ajax({
            type: 'POST',
            url: "/Home/ChangeCountryByRegion",
            data: { "region": region },
            beforeSend: function () {
                //$("#divcover").show();
                $('.option_countrylist').html('<img style="width:30px;height:30px;margin:auto;margin-top: 10%; opacity:1 !important" src="/asset/img/ajax-loader.gif"/>');

            },
            complete: function () {
                //$("#divcover").hide();
                $('.option_countrylist').find("img").remove();
                $(".deslist_box").css({ "pointer-events": "all" })

            },
            success: function (data) {

                bindData1(data);
            },
            error: function () { }
        });
    } else {
        $(this).find(".deslistmap").removeClass("mapactive");
        $('.option_countrylist').html("");
        $("input[name='country']").val("");
        $("input[name='region']").val("");
        $(".deslist_box").css({ "pointer-events": "all" });
        $(this).parents("form").find(".option_countrybox").hide();
    }


})


$(".option_countrylist span").click(function () {
    $(this).toggleClass('countryactive');
})

$(".option_yearlist span").click(function () {

    var bool = $(this).is(".countryactive");
    var _this = $(this);
    $(".option_yearlist span").removeClass("countryactive");
    $(".option_monthlist span").removeClass('countryactive');
    var year = $(this).text();
    if (!bool) {
        $(this).addClass("countryactive");
        $.ajax({
            type: "post",
            url: "/Home/GetSearchDateTime",
            data: { datatime: year },
            success: function (res) {

                var currentDate = new Date();
                var newYear = currentDate.getFullYear();
                var month = currentDate.getMonth() + 1;
                $.each(_this.parents(".dataoption").find(".option_monthbox .option_monthlist span"), function () {
                    var day = $(this).data("days");
                    var calssThis = $(this);

                    if (res.SearchDate.length > 0) {
                        $.each(res.SearchDate, function (index, value) {
                            if (day == value) {
                                if (newYear == year) {
                                    if (day >= month) {
                                        calssThis.removeClass("monthdisable");
                                        return false;
                                    } else {
                                        calssThis.addClass("monthdisable");
                                        return false;
                                    }
                                  
                                }
                                else {
                                    calssThis.removeClass("monthdisable");
                                    return false;
                                }
                               
                            } else {
                                calssThis.addClass("monthdisable");
                            }

                        })
                    } else {
                        calssThis.addClass("monthdisable");
                    }


                })
                _this.parents(".dataoption").find(".option_monthbox").show();

            },
            error: function () { }
        });


    } else {
        $(this).removeClass("countryactive");
        $(this).parents(".dataoption").find(".option_monthbox").hide();
    }

})
$(".option_monthlist span").click(function () {
    if ($(".option_yearlist .countryactive").length > 0) {
        if ($(this).hasClass("monthdisable")) {

        } else {
            $(this).toggleClass('countryactive');
        }
    }

})
function bindData1(data) {
    var list = eval(data);
    var htmlStr = "";//"<option value=''>Select Country</option>";
    for (var mod in list) {
        if (list[mod].Id != "88253") {
            //   htmlStr += "<option data-country='" + list[mod].Name + "'value='" + list[mod].Id + "'>" + list[mod].Name + "</option>";
            // htmlStr += "<span data-country='" + list[mod].Name + "'value='" + list[mod].Id + "'>" + list[mod].Name + "</span >";
            htmlStr += "<span data-id='" + list[mod].CountryId + "'>" + list[mod].CountryName + "</span >";

        }
    }

    $('.option_countrylist').html(htmlStr);
    $(".option_countrylist span").click(function () {

        $(this).toggleClass('countryactive');

    })
}
