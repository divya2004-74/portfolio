let maxHeight = 0;
setTimeout(function () {
    $('.optional_swiperlist').each(function () {
        const height = $(this).outerHeight();
        if (height > maxHeight) maxHeight = height;
    });
    $('.optional_swiperlist').height(maxHeight);
}, 8000);

setTimeout(function () {
    $('.hotels_swiperlist').each(function () {
        const height = $(this).outerHeight();
        if (height > maxHeight) maxHeight = height;
    });
    $('.hotels_swiperlist').height(maxHeight);
}, 8000);
//dateprice手机端换行
function handleDateLineBreak() {
    if (window.innerWidth <= 600) {
        $('.scionphoneprice tr td:first-child').each(function () {
            $(this).html($(this).html().replace(' - ', ' -<br>'));
        });
    } else {
        $('.scionphoneprice tr td:first-child').each(function () {
            $(this).html($(this).html().replace(' -<br>', ' - '));
        });
    }
}

$(window).on('load', handleDateLineBreak);
$(window).on('resize', handleDateLineBreak);