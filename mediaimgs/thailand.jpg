            <use href="/images/icons/global.svg?v=7#tailor" />
          </svg>
          <h3 class="h4">100% Tailor made</h3>
          <ul class="trust-card__list">
            <li>Your entire vacation is designed around your requirements</li>
            <li>Explore your interests at your own speed</li>
            <li>Select your preferred style of accommodations</li>
            <li>Create the perfect trip with the help of our specialists</li>
          </ul>
        </div>
      </div>

      <div class="col col--sm-1/2 col--lg-1/4">
        <div class="trust-card">
