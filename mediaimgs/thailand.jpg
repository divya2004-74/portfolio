    <img class="lazy" data-src="https://cdn.audleytravel.com/270/355/79/7992458-cruising-around-little-guilin-in-cheow-larn-lake.jpg" data-srcset="https://cdn.audleytravel.com/270/355/79/7992458-cruising-around-little-guilin-in-cheow-larn-lake.jpg 270w, https://cdn.audleytravel.com/350/460/79/7992458-cruising-around-little-guilin-in-cheow-larn-lake.jpg 350w, https://cdn.audleytravel.com/530/697/60/7992458-cruising-around-little-guilin-in-cheow-larn-lake.jpg 530w, https://cdn.audleytravel.com/700/921/60/7992458-cruising-around-little-guilin-in-cheow-larn-lake.jpg 700w" data-sizes="auto" alt="Cruising around 'Little Guilin' in Cheow Larn Lake" width="270" height="192" >
  </div>
